+void MainWindow::alignSelected(int axis){
+    QList<int> photos=canvas_->selectedPhotos(),decos=canvas_->selectedDecorations();
+    QVector<QRectF> rectangles;
+    const QVector<Slot> slots=photoSlots(design_);
+    if(!photos.isEmpty()){
+        for(int i:photos)if(i>=0&&i<slots.size())rectangles<<slots[i].r;
+    } else if(!decos.isEmpty()){
+        for(int i:decos)if(i>=0&&i<design_.decorations.size())rectangles<<design_.decorations[i].rect;
+    }
+    if(rectangles.size()<2)return;
+    QRectF group=rectangles[0];for(int i=1;i<rectangles.size();++i)group=group.united(rectangles[i]);
+    auto align=[&](QRectF r){
+        if(axis==0)r.moveLeft(group.left());
+        if(axis==1)r.moveCenter(QPointF(group.center().x(),r.center().y()));
+        if(axis==2)r.moveRight(group.right());
+        if(axis==3)r.moveTop(group.top());
+        if(axis==4)r.moveCenter(QPointF(r.center().x(),group.center().y()));
+        if(axis==5)r.moveBottom(group.bottom());
+        return r;
+    };
+    if(!photos.isEmpty())for(int i:photos)if(i>=0&&i<slots.size()&&!design_.photos[i].locked){design_.photos[i].rect=align(slots[i].r);design_.photos[i].hasRect=true;}
+    if(!decos.isEmpty())for(int i:decos)if(i>=0&&i<design_.decorations.size()&&!design_.decorations[i].locked)design_.decorations[i].rect=align(design_.decorations[i].rect);
+    modified();syncObjectControls();
