+class _OverlayPainter:
+    """Tag temporary canvas items, preserving existing item tags (e.g. node indices)."""
+    __slots__ = ('canvas',)
+    def __init__(self, canvas):
+        self.canvas = canvas
+    def __getattr__(self, name):
+        fn = getattr(self.canvas, name)
+        if not name.startswith('create_'):
+            return fn
+        def create(*args, **kwargs):
+            tags = kwargs.get('tags', ())
+            if isinstance(tags, str):
+                tags = (tags,)
+            kwargs['tags'] = tuple(tags) + ('vf_overlay',)
+            return fn(*args, **kwargs)
+        return create
+
